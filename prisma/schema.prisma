generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Lead {
  id            String   @id @default(cuid())
  name          String
  phone         String
  model         String?
  interest      String   @default("general")
  area          String?
  preferredDate String?
  message       String?
  lang          String   @default("id")
  source        String   @default("website")
  status        String   @default("new")
  createdAt     DateTime @default(now())
}

/// Ulasan pelanggan ASLI. published=false sampai dimoderasi pemilik.
/// JSON-LD aggregateRating/review HANYA dibangkitkan dari data published —
/// anti-fabrication: tidak ada rating palsu (Google spam policy).
model Review {
  id        String   @id @default(cuid())
  modelId   String
  name      String
  city      String?
  rating    Int
  comment   String
  published Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([modelId, published])
}
